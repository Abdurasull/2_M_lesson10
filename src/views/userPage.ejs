<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Responsive Todo List</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3595/3595455.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/userPage.css">
</head>

<body>
    <div class="container">
        <div class="profile">
            <img src="https://www.iconpacks.net/icons/2/free-user-icon-3296-thumb.png" alt="User" />
            <div class="profile-info">
                <h2 class="js-username">Foydalanuvchi Nomi</h2>
                <p class="js-bio note">foydalanuvchi@email.com</p>
            </div>
        </div>

        <form class="todo-form add-todo">
            <input type="text" name="newTodo" placeholder="Yangi vazifa kiriting..." required />
            <button class="js-add-todo" type="submit">Qo'shish</button>
        </form>

        <div class="filter-buttons">
            <button>Barchasi</button>
            <button>Faollar</button>
            <button>Bajarilganlar</button>
        </div>

        <div class="todo-list">
            <% if(todos.length===0) { %>
                <h2 class="note">Sizda hali hech qanday vazifa yo‘q</h2>
            <% } else { %>
            <% todos.forEach(todo => { %>
            <div class="todo-item">
                <div>
                    <p><%= todo.title %></p>
                    <div class="timestamps">
                        <span>Yaratilgan: todo.createdAt</span><br>
                        <span>Yangilangan: todo.updatedAt</span>
                    </div>
                </div>
                <div class="actions">
                    <input data-idCheck="<%= todo.id %>" type="checkbox" title="Bajarildi">
                    <button class="edit" data-idEdit = "<%= todo.id %>">✏️</button>
                    <button data-idDelete="<%= todo.id %>">❌</button>
                </div>
            </div>
            <% }) %>
            <% } %>
            <!-- Qo‘shimcha vazifalar shu yerga JS orqali qo‘shiladi -->
        </div>
    </div>

    <div class="modal" id="editModal">
        <form class="modal-content">
            <h3>Vazifani tahrirlash</h3>
            <textarea rows="3" name="editTodo" placeholder="Tavsif yoki ma’lumot..."></textarea>
            <div class="modal-actions">
                <button class="save">Saqlash</button>
                <p class="cancel">Bekor qilish</p>
            </div>
        </form>
    </div>
    <script src="/js/userPage.js"></script>
</body>

</html>