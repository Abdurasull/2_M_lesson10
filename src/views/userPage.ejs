
<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Responsive Todo List</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3595/3595455.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/userPage.css">
</head>

<body>
    <div class="container">
        <div class="profile">
            <div class="profile-content">
                <div>
                    <img src="https://www.iconpacks.net/icons/2/free-user-icon-3296-thumb.png" alt="User" />
                    <div class="profile-info">
                        <h2 class="js-username">Foydalanuvchi Nomi</h2>
                        <p class="js-bio note">foydalanuvchi@email.com</p>
                    </div>
                </div>
                <button class="logout-btn" title="Profildan chiqish" >
                    <!-- Logout SVG Icon (Heroicons style) -->
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 002 2h3a2 2 0 002-2V7a2 2 0 00-2-2h-3a2 2 0 00-2 2v1" />
                    </svg>
                </button>
            </div>
        </div>

        <form class="todo-form add-todo">
            <input type="text" name="newTodo" placeholder="Yangi vazifa kiriting..." required />
            <button class="js-add-todo" type="submit">Qo'shish</button>
        </form>

        <div class="filter-buttons">
            <button class="All_todos">Barchasi</button>
            <button class="active_todos">Faollar</button>
            <button class="no_active_todos">Bajarilganlar</button>
        </div>

        <div class="todo-list">
           
            <% if(todos.length===0) { %>
                <h2 class="note">Sizda hali hech qanday vazifa yo‘q</h2>
            <% } else { %>
            <% todos.forEach(todo => { %>
            <div class="todo-item">
                <div>
                    <p><%= todo.title %></p>
                    <div class="timestamps">
                        <span>Yaratilgan: <%= todo.createdAt %></span><br>
                        <% if(todo.updatedAt) { %>
                            <span>Yangilangan: <%= todo.updatedAt %></span><br>
                        <% } else { %>
                            <span>Yangilangan: yo‘q</span><br>
                        <% } %>
                    </div>
                </div>
                <div class="actions">
                    <% if(!todo.completed) { %>
                        <input id="mycheckbox" data-iddone="<%= todo.id %>" type="checkbox" >
                    <% } else { %>
                        <input id="mycheckbox" data-iddone="<%= todo.id %>" type="checkbox" checked>
                    <% } %>
                    <button class="edit" data-idEdit = "<%= todo.id %>">✏️</button>
                    <button data-idDelete="<%= todo.id %>">❌</button>
                </div>
            </div>
            <% }) %>
            <% } %>
            <!-- Qo‘shimcha vazifalar shu yerga JS orqali qo‘shiladi -->
        </div>
    </div>

    <div class="modal" id="editModal">
        <form class="modal-content">
            <h3>Vazifani tahrirlash</h3>
            <textarea rows="3" name="editTodo" placeholder="Tavsif yoki ma’lumot..."></textarea>
            <div class="modal-actions">
                <button class="save">Saqlash</button>
                <p class="cancel">Bekor qilish</p>
            </div>
        </form>
    </div>
    <script src="/js/userPage.js"></script>
</body>

</html>